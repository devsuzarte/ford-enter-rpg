@{
    ViewData["Title"] = "Entrar";
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — FordEnterRPG</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <style>
        body {
            background-color: #0d0b09;
            color: #ddd8c8;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .card {
            background-color: #15120e;
            border: 1px solid #2e2820;
            border-radius: 12px;
            width: 100%;
            max-width: 420px;
            padding: 2rem;
        }
        .card-title {
            color: #d4a84b;
            font-size: 1.6rem;
            font-weight: bold;
            text-align: center;
            margin-bottom: 1.5rem;
        }
        .form-label {
            color: #9a9070;
            font-size: 0.9rem;
        }
        .form-control {
            background-color: #0d0b09;
            border: 1px solid #3c3426;
            color: #ddd8c8;
            border-radius: 8px;
        }
        .form-control:focus {
            background-color: #0d0b09;
            border-color: #a07830;
            color: #ddd8c8;
            box-shadow: 0 0 0 0.2rem rgba(160, 120, 48, 0.25);
        }
        .form-control::placeholder { color: #505040; }
        .btn-entrar {
            background-color: #a07830;
            border-color: #c89838;
            color: #fff;
            width: 100%;
            padding: 0.65rem;
            font-size: 1rem;
            border-radius: 8px;
        }
        .btn-entrar:hover {
            background-color: #c89838;
            border-color: #c89838;
            color: #fff;
        }
        .link-cadastro {
            color: #c89838;
            text-decoration: none;
        }
        .link-cadastro:hover { color: #d4a84b; text-decoration: underline; }
        .error-msg {
            background-color: #2a0a0a;
            border: 1px solid #6a2a2a;
            border-radius: 8px;
            padding: 0.6rem 0.9rem;
            color: #ff9a9a;
            font-size: 0.9rem;
            margin-bottom: 1rem;
        }
    </style>
</head>
<body>
<div class="card shadow-lg">

    <div class="card-title">&#9876; FordEnterRPG</div>

    @if (!ViewData.ModelState.IsValid)
    {
        foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <div class="error-msg">@err.ErrorMessage</div>
        }
    }

    <form method="post" action="/SignIn">
        <div class="mb-3">
            <label class="form-label" for="email">E-mail</label>
            <input id="email" type="email" name="email" class="form-control"
                   placeholder="seu@email.com" autocomplete="email" required />
        </div>
        <div class="mb-4">
            <label class="form-label" for="password">Senha</label>
            <input id="password" type="password" name="password" class="form-control"
                   placeholder="••••••••" autocomplete="current-password" required />
        </div>
        <button type="submit" class="btn btn-entrar">Entrar</button>
    </form>

    <div class="text-center mt-3" style="font-size:0.9rem; color:#70654a;">
        Nao tem conta?
        <a href="/SignUp" class="link-cadastro">Cadastrar-se</a>
    </div>

</div>
<div id="loader" style="display:none;position:fixed;inset:0;background:rgba(5,4,2,.85);z-index:9999;flex-direction:column;align-items:center;justify-content:center;">
    <div style="width:42px;height:42px;border:4px solid #2e2820;border-top-color:#a07830;border-radius:50%;animation:_sp .65s linear infinite;"></div>
    <div style="color:#9a9070;margin-top:12px;font-size:.82rem;">Carregando...</div>
</div>
<style>@@keyframes _sp{to{transform:rotate(360deg)}}</style>
<script>
(function(){var o=document.getElementById('loader');function s(){o.style.display='flex';}
document.addEventListener('submit',s);
document.addEventListener('click',function(e){var a=e.target.closest('a[href]');if(!a)return;var h=a.getAttribute('href')||'';if(!h||h[0]==='#'||/^(https?:|mailto:)/.test(h))return;s();});})();
</script>
</body>
</html>
