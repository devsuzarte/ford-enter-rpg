@{
    ViewData["Title"] = "Batalha";
    var character = ViewBag.Character as FordEnterRPG.Models.Character;
    var battle    = ViewBag.Battle    as FordEnterRPG.Models.Battle;
    if (character == null || battle == null) { return; }

    string ClassIcon(string c) => c switch
        { "Warrior" => "Guerreiro", "Mage" => "Mago", "Archer" => "Arqueiro", _ => c };

    int playerPct = battle.PlayerCurrentLife <= 0 ? 0
        : (int)(battle.PlayerCurrentLife * 100.0 / Math.Max(1, character.Life));
    int enemyPct  = battle.EnemyCurrentLife <= 0  ? 0
        : (int)(battle.EnemyCurrentLife  * 100.0 / Math.Max(1, battle.EnemyMaxLife));

    string BarColor(int pct) => pct > 50 ? "bg-success" : pct > 25 ? "bg-warning" : "bg-danger";

    string RarityLabel(string r) => r switch
        { "Epic" => "Epico", "Rare" => "Raro", _ => "Comum" };
    string RarityColor(string r) => r switch
        { "Epic" => "#ffd700", "Rare" => "#56b4e9", _ => "#aaaaaa" };
    string EffectLabel(string e, int v) => e switch
    {
        "Crit"  => "50% Critico",
        "Stun"  => "30% Atordoar",
        "Heal"  => $"+{v} HP",
        _       => "—"
    };

    // Colore as linhas do log por prefixo
    string LogLineClass(string line)
    {
        if (line.StartsWith("ATAQUE:"))   return "log-attack";
        if (line.StartsWith("  Dano"))    return "log-dmg";
        if (line.StartsWith("  ") || line.StartsWith("   ")) return "log-detail";
        if (line.StartsWith("VITORIA"))   return "log-win";
        if (line.StartsWith("DERROTA"))   return "log-lose";
        if (line.StartsWith("[ATORDOADO]")) return "log-stun";
        if (line.StartsWith("==="))       return "log-header";
        return "log-normal";
    }
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Batalha #@battle.Id — FordEnterRPG</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <style>
        body { background: #0d0d1a; color: #dcdcf0; font-family: 'Segoe UI', sans-serif; }

        /* Cards */
        .panel { background: #14142a; border: 1px solid #2c2c4a; border-radius: 10px; padding: 1rem 1.2rem; }

        /* Combatentes */
        .combatant-name { font-size: 1.1rem; font-weight: 700; color: #dcdcf0; }
        .combatant-sub  { font-size: 0.82rem; color: #8888a8; }

        /* Barra de HP */
        .hp-bar { height: 18px; border-radius: 6px; background: #1e1e3a; overflow: hidden; }
        .hp-fill { height: 100%; border-radius: 6px; transition: width .3s ease; }
        .hp-text { font-size: 0.85rem; font-weight: 600; white-space: nowrap; }

        /* Log de batalha */
        .battle-log {
            background: #0a0a18;
            border: 1px solid #1e1e38;
            border-radius: 8px;
            padding: 0.8rem 1rem;
            max-height: 280px;
            overflow-y: auto;
            font-size: 0.88rem;
            line-height: 1.65;
        }
        .log-header { color: #5a5a80; font-size: 0.75rem; letter-spacing: .05em; margin-top: 6px; }
        .log-attack  { color: #e0e0e0; font-weight: 600; margin-top: 4px; }
        .log-dmg     { color: #ff9966; }
        .log-detail  { color: #aaaacc; }
        .log-win     { color: #66ff99; font-weight: 700; font-size: 1rem; }
        .log-lose    { color: #ff6666; font-weight: 700; font-size: 1rem; }
        .log-stun    { color: #ffdd55; }
        .log-normal  { color: #c0c0d8; }

        /* Botoes de habilidade */
        .skill-btn {
            display: block;
            width: 100%;
            background: #14142a;
            border: 1px solid #2c2c4a;
            border-radius: 8px;
            padding: 0.7rem 0.9rem;
            text-align: left;
            color: #dcdcf0;
            transition: border-color .15s, background .15s;
        }
        .skill-btn:hover:not(:disabled) {
            border-color: #7c5cbf;
            background: #1e1e38;
            color: #fff;
        }
        .skill-btn:disabled { opacity: .4; cursor: not-allowed; }
        .skill-name  { font-weight: 600; font-size: 0.95rem; }
        .skill-stats { font-size: 0.8rem; color: #8888a8; margin-top: 2px; }

        /* Banners de resultado */
        .banner-win  { background:#0f2d1a; border:1px solid #2a6a3a; border-radius:10px; padding:1.2rem; text-align:center; }
        .banner-lose { background:#2d0f0f; border:1px solid #6a2a2a; border-radius:10px; padding:1.2rem; text-align:center; }

        /* Status badge */
        .stun-badge { font-size:0.75rem; color:#ffdd55; background:#2a2a00; border:1px solid #5a5a00;
                      border-radius:4px; padding:1px 6px; display:inline-block; margin-top:4px; }

        /* Secao de habilidades */
        .skills-label { font-size:0.78rem; color:#6060a0; text-transform:uppercase;
                        letter-spacing:.08em; margin-bottom:8px; }

        /* Botao secundario */
        .btn-secondary-dark {
            background: transparent;
            border: 1px solid #3a3a5a;
            color: #9090b0;
            border-radius: 6px;
            padding: 0.3rem 0.8rem;
            font-size: 0.82rem;
            text-decoration: none;
        }
        .btn-secondary-dark:hover { border-color: #7c5cbf; color: #c0a0ff; }
    </style>
</head>
<body>
<div class="container py-3" style="max-width: 680px;">

    <!-- Cabecalho -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <span style="font-size:1.1rem; font-weight:700; color:#c0a0ff;">
                Batalha #@battle.Id
            </span>
            <span style="font-size:0.85rem; color:#6060a0; margin-left:8px;">
                Turno @battle.TurnCount
            </span>
        </div>
        <a href="/Character" class="btn-secondary-dark">Personagem</a>
    </div>

    <!-- INIMIGO -->
    <div class="panel mb-3">
        <div class="d-flex justify-content-between align-items-start mb-2">
            <div>
                <div class="combatant-name">@battle.EnemyName</div>
                <div class="combatant-sub">@ClassIcon(battle.EnemyClass) &middot; Nivel @battle.EnemyLevel</div>
                @if (battle.EnemyStunned)
                {
                    <span class="stun-badge">ATORDOADO</span>
                }
            </div>
            <span class="hp-text text-danger">@battle.EnemyCurrentLife / @battle.EnemyMaxLife HP</span>
        </div>
        <div class="hp-bar">
            <div class="hp-fill @BarColor(enemyPct)" style="width:@enemyPct%"></div>
        </div>
    </div>

    <!-- LOG -->
    @if (battle.Logs.Any())
    {
        <div class="battle-log mb-3">
            @foreach (var entry in battle.Logs.OrderByDescending(l => l.Turn))
            {
                foreach (var line in entry.Description.Split('\n'))
                {
                    if (string.IsNullOrWhiteSpace(line)) { <div style="height:4px"></div> continue; }
                    <div class="@LogLineClass(line)">@line</div>
                }
            }
        </div>
    }
    else
    {
        <div class="panel mb-3" style="text-align:center; color:#6060a0; font-size:0.88rem;">
            A batalha comecou. Escolha uma habilidade para atacar.
        </div>
    }

    <!-- JOGADOR -->
    <div class="panel mb-3">
        <div class="d-flex justify-content-between align-items-start mb-2">
            <div>
                <div class="combatant-name">@character.Name</div>
                <div class="combatant-sub">@ClassIcon(character.Class) &middot; Nivel @character.Level &middot; Dano +@character.Damage</div>
                @if (battle.PlayerStunned)
                {
                    <span class="stun-badge">ATORDOADO</span>
                }
            </div>
            <span class="hp-text text-success">@battle.PlayerCurrentLife / @character.Life HP</span>
        </div>
        <div class="hp-bar">
            <div class="hp-fill @BarColor(playerPct)" style="width:@playerPct%"></div>
        </div>
    </div>

    <!-- ESTADOS FINAIS -->
    @if (battle.Status == "Lost")
    {
        <div class="banner-lose">
            <div style="font-size:1.3rem; color:#ff6666; font-weight:700; margin-bottom:6px;">Derrota</div>
            <div style="color:#cc8888; margin-bottom:12px;">@battle.EnemyName foi mais forte desta vez.</div>
            <a href="/Battle/Start" class="btn btn-danger btn-sm me-2">Nova Batalha</a>
            <a href="/Character" class="btn btn-outline-secondary btn-sm">Ver Personagem</a>
        </div>
    }
    else if (battle.Status == "Won")
    {
        <div class="banner-win">
            <div style="font-size:1.3rem; color:#66ff99; font-weight:700; margin-bottom:6px;">Vitoria!</div>
            <div style="color:#88cc99; margin-bottom:12px;">
                @battle.EnemyName foi derrotado! Voce e agora Nivel @character.Level.
            </div>
            <a href="/Battle/@battle.Id/Reward" class="btn btn-warning btn-sm">Escolher Recompensa</a>
        </div>
    }
    else
    {
        <!-- HABILIDADES (batalha ativa) -->
        <div class="skills-label">Escolha sua habilidade</div>
        <div class="row g-2">
            @foreach (var cs in character.CharacterSkills.OrderBy(x => x.Slot))
            {
                var s = cs.Skill;
                <div class="col-12 col-sm-6">
                    <form method="post" action="/Battle/@battle.Id/Turn">
                        <input type="hidden" name="skillId" value="@s.Id" />
                        <button type="submit" class="skill-btn">
                            <div class="d-flex justify-content-between align-items-baseline">
                                <span class="skill-name">@s.Name</span>
                                <span style="font-size:0.75rem; color:@RarityColor(s.Rarity)">@RarityLabel(s.Rarity)</span>
                            </div>
                            <div class="skill-stats">
                                @s.BaseDamage dano base &nbsp;&middot;&nbsp; @EffectLabel(s.EffectType, s.EffectValue)
                            </div>
                        </button>
                    </form>
                </div>
            }
        </div>
    }

</div>
</body>
</html>
