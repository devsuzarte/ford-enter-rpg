@using System.Text.RegularExpressions
@using FordEnterRPG.ViewModels
@{
    ViewData["Title"] = "Batalha";
    var character = ViewBag.Character as FordEnterRPG.Models.Character;
    var battle    = ViewBag.Battle    as FordEnterRPG.Models.Battle;
    if (character == null || battle == null) { return; }

    string ClassLabel(string c) => c switch
        { "Warrior" => "Guerreiro", "Mage" => "Mago", "Archer" => "Arqueiro", _ => c };

    string ClassPortrait(string c) => c switch
        { "Warrior" => "/images/warrior.svg", "Mage" => "/images/mage.svg", "Archer" => "/images/archer.svg", _ => "/images/warrior.svg" };

    int playerPct = battle.PlayerCurrentLife <= 0 ? 0
        : (int)(battle.PlayerCurrentLife * 100.0 / Math.Max(1, character.Life));
    int enemyPct = battle.EnemyCurrentLife <= 0 ? 0
        : (int)(battle.EnemyCurrentLife  * 100.0 / Math.Max(1, battle.EnemyMaxLife));

    string BarColor(int pct) => pct > 50 ? "bg-success" : pct > 25 ? "bg-warning" : "bg-danger";

    string RarityLabel(string r) => r switch
        { "Epic" => "Epico", "Rare" => "Raro", _ => "Comum" };
    string RarityColor(string r) => r switch
        { "Epic" => "#ffd700", "Rare" => "#56b4e9", _ => "#aaaaaa" };
    string SkillClassLabel(string c) => c switch
        { "Warrior" => "Guerreiro", "Mage" => "Mago", "Archer" => "Arqueiro", _ => "Universal" };
    string SkillClassColor(string c) => c switch
        { "Warrior" => "#d4804a", "Mage" => "#4890c8", "Archer" => "#60b870", _ => "#8a8468" };
    string EffectLabel(string e, int v) => e switch
    {
        "Crit" => "50% Critico",
        "Stun" => "30% Atordoar",
        "Heal" => $"+{v} HP",
        _      => "—"
    };

    int MissChancePct(FordEnterRPG.Models.Skill s) =>
        (int)(FordEnterRPG.Services.BattleService.GetMissChance(s) * 100);

    List<TurnEvent> ParseEntry(string desc, string playerName)
    {
        var list = new List<TurnEvent>();
        string? pActor = null, pSkill = null, pAdv = null;

        foreach (var raw in desc.Split('\n', StringSplitOptions.RemoveEmptyEntries))
        {
            var ln = raw.Trim();
            if (string.IsNullOrEmpty(ln) || ln.StartsWith("===")) continue;

            if (ln.StartsWith("ATAQUE: "))
            {
                var rest = ln[8..];
                var ui = rest.IndexOf(" usa '");
                if (ui > 0)
                {
                    pActor = rest[..ui];
                    var au = rest[(ui + 6)..];
                    var cq = au.IndexOf('\'');
                    if (cq >= 0)
                    {
                        pSkill = au[..cq];
                        var r2 = au[(cq + 1)..].Trim();
                        pAdv = r2.Contains("DESVANTAGEM") ? "desvantagem"
                             : r2.Contains("VANTAGEM")   ? "vantagem" : "";
                    }
                }
                continue;
            }

            if (ln.Contains("[ERROU]") && pActor != null)
            {
                list.Add(new TurnEvent
                {
                    Type = "miss", Actor = pActor, IsPlayer = pActor == playerName,
                    Skill = pSkill ?? "", Message = "O ataque falhou!"
                });
                pActor = null; pSkill = null; pAdv = null;
                continue;
            }

            if (ln.StartsWith("Dano causado: ") && pActor != null)
            {
                var rest = ln[14..].Trim();
                var si = rest.IndexOf(' ');
                int.TryParse(si > 0 ? rest[..si] : rest, out int dmg);
                var tags = Regex.Matches(rest, @"\[([^\]]+)\]")
                                .Select(m => m.Groups[1].Value).ToArray();
                list.Add(new TurnEvent
                {
                    Type = "attack", Actor = pActor, IsPlayer = pActor == playerName,
                    Skill = pSkill ?? "", Damage = dmg, Tags = tags, Advantage = pAdv ?? ""
                });
                pActor = null; pSkill = null; pAdv = null;
                continue;
            }

            if (ln.StartsWith("[ATORDOADO]"))
            {
                var msg  = ln[12..].Trim();
                var ne   = msg.IndexOf(" não ");
                var name = ne > 0 ? msg[..ne] : msg;
                list.Add(new TurnEvent
                {
                    Type = "stun", Actor = name, IsPlayer = name == playerName,
                    Message = $"{name} esta atordoado e pula este turno."
                });
                continue;
            }

            if (ln.StartsWith("VITORIA"))
            {
                list.Add(new TurnEvent { Type = "win", Message = ln });
                continue;
            }

            if (ln.StartsWith("DERROTA"))
            {
                list.Add(new TurnEvent { Type = "lose", Message = ln });
                continue;
            }

            if (ln.Contains("subiu para o nivel"))
            {
                list.Add(new TurnEvent { Type = "levelup", Message = ln });
                continue;
            }
        }

        return list;
    }

    string TagClass(string tag) =>
        tag.StartsWith("CRITICO")  ? "badge-crit" :
        tag.StartsWith("ATORDOOU") ? "badge-stun" :
        tag.StartsWith("CURA")     ? "badge-heal" : "badge-def";

    /* data passed to JS */
    int    esSlotTurn  = ViewBag.EnemySlotTurn  != null ? (int)ViewBag.EnemySlotTurn  : 0;
    bool   esSlotHit   = ViewBag.EnemySlotHit   != null ? (bool)ViewBag.EnemySlotHit  : false;
    string esSlotSkill = ViewBag.EnemySlotSkill as string ?? "";
    string psSlotHitJs = ViewBag.PlayerSlotHit  != null ? ((bool)ViewBag.PlayerSlotHit ? "true" : "false") : "null";
    string psSlotSkill = ViewBag.PlayerSlotSkill as string ?? "";
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Batalha #@battle.RunSequence — FordEnterRPG</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/css/theme.css" />
    <style>
        body { display:flex; justify-content:center; align-items:flex-start; padding:1.5rem 1rem; }

        .combatant-name { font-size:1.05rem; font-weight:700; color:#ddd8c8; font-family:var(--font-label); letter-spacing:.04em; }
        .combatant-sub  { font-size:0.80rem; color:#9a9070; }

        /* ── Carousel ── */
        .carousel-wrap { background:#15120e; border:1px solid #2e2820; border-radius:10px; overflow:hidden; margin-bottom:1rem; }
        .carousel-nav  { display:flex; align-items:center; justify-content:space-between;
                         padding:.45rem .8rem; background:#0d0b09; border-bottom:1px solid #2e2820; }
        .nav-btn { background:transparent; border:1px solid #3c3426; color:#9a9070;
                   border-radius:6px; padding:.15rem .65rem; font-size:1rem;
                   cursor:pointer; line-height:1.4; transition:border-color .15s,color .15s; }
        .nav-btn:hover:not(:disabled) { border-color:#a07830; color:#d4a84b; }
        .nav-btn:disabled { opacity:.3; cursor:not-allowed; }
        .turn-indicator { font-size:.76rem; color:#70654a; letter-spacing:.06em; font-family:var(--font-label); }

        .turn-slide { display:none; }
        .turn-body  { padding:.7rem .8rem; display:flex; flex-direction:column; gap:.45rem; min-height:90px; }

        .ev-row {
            background:#0a0806; border-radius:8px;
            padding:.55rem .75rem; border-left:3px solid transparent;
        }
        .ev-row.is-player { border-left-color:#a07830; }
        .ev-row.is-enemy  { border-left-color:#cc4444; }
        .ev-row.is-stun   { border-left-color:#aaaa00; background:#131300; }
        .ev-row.is-win    { border-left-color:#22cc66; background:#041008; }
        .ev-row.is-lose   { border-left-color:#cc2222; background:#100404; }
        .ev-row.is-level  { border-left-color:#c89838; background:#100d04; }

        .ev-actor         { font-size:.74rem; font-weight:600; margin-bottom:.18rem; }
        .ev-actor.player  { color:#d4a84b; }
        .ev-actor.enemy   { color:#ff8888; }
        .ev-skill         { font-size:.92rem; font-weight:600; color:#ddd8c8; }
        .ev-damage        { font-size:1.05rem; font-weight:700; color:#ffaa44; }
        .ev-unit          { font-size:.72rem; color:#9a9070; margin-left:2px; }

        .ev-row.is-miss   { border-left-color:#666655; background:#111108; }
        .ev-msg-miss  { font-size:.83rem; color:#888877; font-style:italic; }
        .ev-msg-stun  { font-size:.83rem; color:#cccc44; }
        .ev-msg-win   { font-size:.86rem; color:#44cc88; font-weight:600; }
        .ev-msg-lose  { font-size:.86rem; color:#cc4444; font-weight:600; }
        .ev-msg-level { font-size:.80rem; color:#c89838; }

        .miss-pct { font-size:.7rem; color:#888877; margin-left:4px; }

        /* ── Skill buttons ── */
        .skill-btn {
            display:block; width:100%; background:#15120e;
            border:1px solid #2e2820; border-radius:8px;
            padding:.65rem .85rem; text-align:left;
            color:#ddd8c8; transition:border-color .15s,background .15s;
            cursor: pointer;
        }
        .skill-btn:hover:not(:disabled) { border-color:#a07830; background:#1e1a10; color:#fff; }
        .skill-btn:disabled { opacity:.4; cursor:not-allowed; }
        .skill-name  { font-weight:700; font-size:.93rem; font-family:var(--font-label); letter-spacing:.03em; }
        .skill-stats { font-size:.78rem; color:#9a9070; margin-top:2px; }
        .skills-label { font-size:.72rem; color:#70654a; text-transform:uppercase;
                        letter-spacing:.12em; margin-bottom:8px; font-family:var(--font-label); }

        /* ── End banners ── */
        .banner-win  { background:#0f2d1a; border:1px solid #2a6a3a; border-radius:10px; padding:1.2rem; text-align:center; }
        .banner-lose { background:#2d0f0f; border:1px solid #6a2a2a; border-radius:10px; padding:1.2rem; text-align:center; }

        /* ── Combatant panel portrait ── */
        .combatant-portrait {
            width:52px; height:52px; object-fit:contain;
            border-radius:8px; background:#0d0b09;
            padding:2px; flex-shrink:0;
        }
        .enemy-portrait-wrap { filter: hue-rotate(140deg) saturate(0.6); }

        /* ── Dice overlay ── */
        .dice-overlay {
            display:none; position:fixed; inset:0;
            background:rgba(5,4,2,.94); z-index:10100;
            flex-direction:column; align-items:center; justify-content:center;
            gap:1rem;
        }
        .dice-title    { font-size:1.2rem; font-weight:700; color:#d4a84b; letter-spacing:.1em; text-transform:uppercase; font-family:var(--font-label); text-shadow:0 0 16px rgba(201,162,39,.4); }
        .dice-subtitle { font-size:.82rem; color:#9a9070; font-family:var(--font-label); letter-spacing:.04em; }
        .dice-canvas-wrap { width:min(520px,92vw); height:auto; }
        .dice-vs-row   { display:none; align-items:center; gap:1.4rem; font-size:2rem; font-weight:700; font-family:var(--font-label); }
        .dice-score    { min-width:2rem; text-align:center; }
        .dice-vs-label { color:#70654a; font-size:1rem; font-family:var(--font-label); }
        .dice-result-msg { font-size:1.1rem; font-weight:700; display:none; font-family:var(--font-label); letter-spacing:.06em; }
    </style>
</head>
<body>
<div id="battle-layout" style="width:100%;max-width:680px;margin:0 auto;">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <span class="rpg-label" style="font-size:1.1rem;font-weight:700;">Batalha #@battle.RunSequence</span>
            <span style="font-size:0.82rem;color:#70654a;margin-left:8px;font-family:var(--font-label);letter-spacing:.04em;">Turno @battle.TurnCount</span>
        </div>
        <a href="/Character" class="btn-ghost">Personagem</a>
    </div>

    <!-- Enemy panel -->
    <div class="panel mb-3">
        <div class="d-flex align-items-start gap-3 mb-2">
            <div class="enemy-portrait-wrap">
                <img src="@ClassPortrait(battle.EnemyClass)" alt="@battle.EnemyName" class="combatant-portrait" />
            </div>
            <div class="flex-grow-1">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="combatant-name">@battle.EnemyName</div>
                        <div class="combatant-sub">@ClassLabel(battle.EnemyClass) &middot; Nivel @battle.EnemyLevel</div>
                        @if (battle.EnemyStunned) { <span class="stun-badge">ATORDOADO</span> }
                    </div>
                    <span class="hp-text text-danger">@battle.EnemyCurrentLife / @battle.EnemyMaxLife HP</span>
                </div>
                <div class="hp-bar mt-2"><div class="hp-fill @BarColor(enemyPct)" style="width:@enemyPct%"></div></div>
            </div>
        </div>
    </div>

    <!-- Turn log carousel -->
    @if (battle.Logs.Any())
    {
        var sortedLogs = battle.Logs.OrderBy(l => l.Turn).ToList();

        <div class="carousel-wrap mb-3">
            <div class="carousel-nav">
                <button class="nav-btn" id="btn-prev">&#8592;</button>
                <span class="turn-indicator" id="turn-indicator"></span>
                <button class="nav-btn" id="btn-next">&#8594;</button>
            </div>

            <div id="carousel-slides">
                @foreach (var entry in sortedLogs)
                {
                    var events = ParseEntry(entry.Description, character.Name);
                    <div class="turn-slide" data-turn="@entry.Turn">
                        <div class="turn-body">
                            @foreach (var ev in events)
                            {
                                @if (ev.Type == "attack")
                                {
                                    <div class="ev-row @(ev.IsPlayer ? "is-player" : "is-enemy")">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span class="ev-actor @(ev.IsPlayer ? "player" : "enemy")">
                                                @Html.Raw(ev.IsPlayer ? "&#9876;" : "&#9760;") @ev.Actor
                                            </span>
                                            @if (ev.Advantage == "vantagem")
                                            {
                                                <span class="btag badge-adv">VANTAGEM</span>
                                            }
                                            else if (ev.Advantage == "desvantagem")
                                            {
                                                <span class="btag badge-dis">DESVANTAGEM</span>
                                            }
                                        </div>
                                        <div class="d-flex justify-content-between align-items-baseline mt-1">
                                            <span class="ev-skill">@ev.Skill</span>
                                            <div>
                                                <span class="ev-damage">@ev.Damage</span>
                                                <span class="ev-unit">dano</span>
                                                @foreach (var tag in ev.Tags)
                                                {
                                                    <span class="btag @TagClass(tag)">@tag</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                                else if (ev.Type == "miss")
                                {
                                    <div class="ev-row is-miss @(ev.IsPlayer ? "is-player" : "is-enemy")" style="border-left-color:#555544;">
                                        <div class="ev-actor @(ev.IsPlayer ? "player" : "enemy")">
                                            @Html.Raw(ev.IsPlayer ? "&#9876;" : "&#9760;") @ev.Actor &mdash; <span class="ev-skill">@ev.Skill</span>
                                        </div>
                                        <span class="ev-msg-miss">&#10006; @ev.Message</span>
                                    </div>
                                }
                                else if (ev.Type == "stun")
                                {
                                    <div class="ev-row is-stun">
                                        <span class="ev-msg-stun">&#9889; @ev.Message</span>
                                    </div>
                                }
                                else if (ev.Type == "win")
                                {
                                    <div class="ev-row is-win">
                                        <span class="ev-msg-win">&#9733; @ev.Message</span>
                                    </div>
                                }
                                else if (ev.Type == "lose")
                                {
                                    <div class="ev-row is-lose">
                                        <span class="ev-msg-lose">&#9760; @ev.Message</span>
                                    </div>
                                }
                                else if (ev.Type == "levelup")
                                {
                                    <div class="ev-row is-level">
                                        <span class="ev-msg-level">&#9650; @ev.Message</span>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="panel mb-3" style="text-align:center;color:#70654a;font-size:.88rem;">
            A batalha comecou. Role o dado de iniciativa e escolha sua habilidade.
        </div>
    }

    <!-- Player panel -->
    <div class="panel mb-3">
        <div class="d-flex align-items-start gap-3 mb-2">
            <img src="@ClassPortrait(character.Class)" alt="@character.Name" class="combatant-portrait" />
            <div class="flex-grow-1">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="combatant-name">@character.Name</div>
                        <div class="combatant-sub">@ClassLabel(character.Class) &middot; Nivel @character.Level &middot; Dano +@character.Damage</div>
                        @if (battle.PlayerStunned) { <span class="stun-badge">ATORDOADO</span> }
                    </div>
                    <span class="hp-text text-success">@battle.PlayerCurrentLife / @character.Life HP</span>
                </div>
                <div class="hp-bar mt-2"><div class="hp-fill @BarColor(playerPct)" style="width:@playerPct%"></div></div>
            </div>
        </div>
    </div>

    <!-- End / skill actions -->
    @if (battle.Status == "Lost")
    {
        <div class="banner-lose">
            <div style="font-size:1.3rem;color:#ff6666;font-weight:700;margin-bottom:6px;">Derrota</div>
            <div style="color:#cc8888;margin-bottom:14px;">
                @battle.EnemyName foi mais forte desta vez.<br />
                <span style="font-size:.82rem;">Sua run terminou. Reinicie para escolher uma nova classe.</span>
            </div>
            <form method="post" action="/Character/Reset" class="d-inline">
                <button type="submit" class="btn btn-danger btn-sm">Nova Run</button>
            </form>
        </div>
    }
    else if (battle.Status == "Won")
    {
        <div class="banner-win">
            <div style="font-size:1.3rem;color:#66ff99;font-weight:700;margin-bottom:6px;">Vitoria!</div>
            <div style="color:#88cc99;margin-bottom:14px;">
                @battle.EnemyName foi derrotado! Voce e agora Nivel @character.Level.
            </div>
            <a href="/Battle/@battle.Id/Reward" class="btn-rpg">Escolher Recompensa &rarr;</a>
        </div>
    }
    else
    {
        <div class="skills-label">Escolha sua habilidade</div>
        <div class="row g-2">
            @foreach (var cs in character.CharacterSkills.OrderBy(x => x.Slot))
            {
                var s = cs.Skill;
                <div class="col-12 col-sm-6">
                    <form method="post" action="/Battle/@battle.Id/Turn" class="skill-form" data-no-loader data-miss-chance="@MissChancePct(s)">
                        <input type="hidden" name="skillId" value="@s.Id" />
                        <input type="hidden" name="isHit" value="" />
                        <input type="hidden" name="playerGoesFirst" value="true" />
                        <button type="submit" class="skill-btn">
                            <div class="d-flex justify-content-between align-items-baseline">
                                <span class="skill-name">@s.Name</span>
                                <div class="d-flex align-items-baseline gap-2">
                                    @if (MissChancePct(s) == 0)
                                    {
                                        <span class="miss-pct" style="color:#66dd88;">Sempre acerta</span>
                                    }
                                    else
                                    {
                                        <span class="miss-pct">@MissChancePct(s)% de erro</span>
                                    }
                                    <span style="font-size:.73rem;color:@RarityColor(s.Rarity)">@RarityLabel(s.Rarity)</span>
                                </div>
                            </div>
                            <div class="skill-stats">
                                @s.BaseDamage dano base &nbsp;&middot;&nbsp; @EffectLabel(s.EffectType, s.EffectValue)
                                &nbsp;&middot;&nbsp;
                                <span style="color:@SkillClassColor(s.ClassName)">@SkillClassLabel(s.ClassName)</span>
                            </div>
                        </button>
                    </form>
                </div>
            }
        </div>
    }

</div>

<!-- Player slot machine overlay -->
<div id="slot-overlay" class="slot-overlay">
    <div class="slot-title">Executando habilidade</div>
    <div id="slot-skill-name" class="slot-skill-name"></div>
    <div class="slot-window">
        <div class="slot-indicator"></div>
        <div id="slot-strip" class="slot-strip"></div>
    </div>
    <div id="slot-result" style="font-size:1.1rem;font-weight:700;min-height:1.5rem;opacity:0;transition:opacity .3s;letter-spacing:.04em;"></div>
    <button id="slot-continue-btn" class="btn-rpg" style="display:none;margin-top:1.2rem;">Continuar &rsaquo;</button>
</div>

<!-- Enemy slot machine overlay -->
<div id="enemy-slot-overlay" class="slot-overlay" style="background:rgba(20,4,4,.95);">
    <div class="slot-title" style="color:#ff9966;">Ataque Inimigo</div>
    <div id="enemy-slot-name" class="slot-skill-name" style="color:#ffaa88;"></div>
    <div class="slot-window" style="border-color:#3a1a1a;">
        <div class="slot-indicator" style="border-color:rgba(200,60,60,.25);"></div>
        <div id="enemy-slot-strip" class="slot-strip"></div>
    </div>
    <div id="enemy-slot-result" style="font-size:1.1rem;font-weight:700;min-height:1.5rem;opacity:0;transition:opacity .3s;letter-spacing:.04em;"></div>
    <button id="enemy-slot-continue-btn" class="btn-rpg" style="display:none;margin-top:1.2rem;">Continuar &rsaquo;</button>
</div>

<!-- Dice initiative overlay -->
<div id="dice-overlay" class="dice-overlay">
    <div class="dice-title">&#9856; Iniciativa</div>
    <div class="dice-subtitle">Role o dado — quem tirar mais alto ataca primeiro</div>
    <div class="dice-canvas-wrap" id="dice-canvas-wrap"></div>
    <div class="dice-vs-row" id="dice-vs-row">
        <div>
            <div style="font-size:.7rem;color:#9a9070;text-align:center;margin-bottom:.2rem;">Voce</div>
            <div class="dice-score" id="dice-player-score" style="color:#d4a84b;">?</div>
        </div>
        <div class="dice-vs-label">vs</div>
        <div>
            <div style="font-size:.7rem;color:#9a9070;text-align:center;margin-bottom:.2rem;">Inimigo</div>
            <div class="dice-score" id="dice-enemy-score" style="color:#ff8888;">?</div>
        </div>
    </div>
    <div class="dice-result-msg" id="dice-result-msg"></div>
    <button id="dice-roll-btn" class="btn-rpg" style="margin-top:.5rem;">Rolar!</button>
    <button id="dice-continue-btn" class="btn-rpg" style="display:none;margin-top:.5rem;">Batalhar!</button>
</div>

<!-- Generic loader -->
<div id="loader" class="loader-overlay">
    <div class="loader-spinner"></div>
    <div class="loader-label">Carregando...</div>
</div>

<!-- battle state for JS -->
<script>
var battleTurnCount       = @battle.TurnCount;
var battleId              = @battle.Id;
var battleStatus          = @Html.Raw(Json.Serialize(battle.Status));
