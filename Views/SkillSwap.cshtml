@{
    ViewData["Title"] = "Habilidade Obtida";

    var acquiredName        = TempData["AcquiredSkillName"]?.ToString() ?? "";
    var acquiredRarity      = TempData["AcquiredSkillRarity"]?.ToString() ?? "Common";
    var acquiredClassName   = TempData["AcquiredSkillClassName"]?.ToString() ?? "Any";
    var acquiredBaseDamage  = int.TryParse(TempData["AcquiredSkillBaseDamage"]?.ToString(), out int ad) ? ad : 0;
    var acquiredEffectType  = TempData["AcquiredSkillEffectType"]?.ToString() ?? "";
    var acquiredEffectValue = int.TryParse(TempData["AcquiredSkillEffectValue"]?.ToString(), out int aev) ? aev : 0;
    var acquiredDescription = TempData["AcquiredSkillDescription"]?.ToString() ?? "";

    var replacedName        = TempData["ReplacedSkillName"]?.ToString();
    var replacedRarity      = TempData["ReplacedSkillRarity"]?.ToString() ?? "Common";
    var replacedClassName   = TempData["ReplacedSkillClassName"]?.ToString() ?? "Any";
    var replacedBaseDamage  = int.TryParse(TempData["ReplacedSkillBaseDamage"]?.ToString(), out int rd) ? rd : 0;
    var replacedEffectType  = TempData["ReplacedSkillEffectType"]?.ToString() ?? "";
    var replacedEffectValue = int.TryParse(TempData["ReplacedSkillEffectValue"]?.ToString(), out int rev) ? rev : 0;
    var replacedDescription = TempData["ReplacedSkillDescription"]?.ToString() ?? "";

    bool wasReplacement = replacedName != null;

    string RarityLabel(string r) => r switch
        { "Epic" => "Epico", "Rare" => "Raro", _ => "Comum" };
    string RarityColor(string r) => r switch
        { "Epic" => "#ffd700", "Rare" => "#56b4e9", _ => "#888899" };
    string SkillClassLabel(string c) => c switch
        { "Warrior" => "Guerreiro", "Mage" => "Mago", "Archer" => "Arqueiro", _ => "Universal" };
    string SkillClassColor(string c) => c switch
        { "Warrior" => "#e08060", "Mage" => "#a080d8", "Archer" => "#60b870", _ => "#8888aa" };
    string EffectLabel(string e, int v) => e switch
    {
        "Crit" => "50% Critico",
        "Stun" => "30% Atordoar",
        "Heal" => $"+{v} HP",
        _      => "Sem efeito"
    };
    string EffectIcon(string e) => e switch
    {
        "Crit" => "⚡",
        "Stun" => "💫",
        "Heal" => "💚",
        _      => "—"
    };
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — FordEnterRPG</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/css/theme.css" />
    <style>
        body { display:flex; justify-content:center; align-items:center; padding:2rem 1rem; }

        .page-title { color:#c0a0ff; font-size:1.5rem; font-weight:700; }
        .page-sub   { color:#8080a0; font-size:.88rem; }

        /* ── Skill cards ── */
        .skill-card {
            background:#14142a; border:2px solid #2c2c4a; border-radius:14px;
            padding:1.4rem 1.1rem; text-align:left; width:200px;
            opacity:0; transform:translateY(20px);
            transition:opacity .5s ease, transform .5s ease;
        }
        .skill-card.visible { opacity:1; transform:translateY(0); }

        .skill-card.acquired { border-color:#7c5cbf; }
        .skill-card.replaced { border-color:#4a2a2a; opacity:.6; transform:translateY(0); }
        .skill-card.replaced.visible { opacity:.65; }

        /* rarity glow on acquired */
        .skill-card.acquired.rarity-epic { box-shadow: 0 0 22px rgba(255,215,0,.4); border-color:#ffd700; }
        .skill-card.acquired.rarity-rare { box-shadow: 0 0 18px rgba(86,180,233,.35); border-color:#56b4e9; }

        .skill-label  { font-size:.68rem; text-transform:uppercase; letter-spacing:.08em;
                        margin-bottom:.5rem; font-weight:600; }
        .skill-name   { font-size:.95rem; font-weight:700; color:#dcdcf0; margin-bottom:.25rem; }
        .skill-rarity { font-size:.72rem; margin-bottom:.4rem; }
        .skill-desc   { font-size:.74rem; color:#6868a0; margin-bottom:.55rem; }
        .skill-stats  { font-size:.78rem; color:#9090b8; }
        .skill-stats strong { color:#e0e0e0; }

        .arrow-col {
            display:flex; align-items:center; font-size:2.2rem; color:#7c5cbf;
            opacity:0; transform:scale(.7);
            transition:opacity .4s ease .3s, transform .4s ease .3s;
        }
        .arrow-col.visible { opacity:1; transform:scale(1); }

        /* sparkle particles */
        @@keyframes sparkle-float {
            0%   { opacity:1; transform:translate(0,0) scale(1); }
            100% { opacity:0; transform:translate(var(--tx),var(--ty)) scale(0); }
        }
        .sparkle {
            position:absolute; pointer-events:none;
            animation:sparkle-float 1s ease-out forwards;
        }
    </style>
</head>
<body>
<div style="width:100%;max-width:580px;margin:0 auto;text-align:center;">

    <div class="page-title mb-1" id="page-title">
        @(wasReplacement ? "Habilidade Substituida!" : "Nova Habilidade!")
    </div>
    <div class="page-sub mb-5">
        @(wasReplacement
            ? "A habilidade mais fraca foi trocada pela nova."
            : "Uma nova habilidade foi adicionada ao seu repertorio.")
    </div>

    <div class="d-flex justify-content-center align-items-center gap-4 mb-5 flex-wrap" id="cards-row">

        @if (wasReplacement)
        {
            <div class="skill-card replaced" id="replaced-card">
                <div class="skill-label" style="color:#ff6666;">Removida</div>
                <div class="skill-name">@replacedName</div>
                <div class="skill-rarity" style="color:@RarityColor(replacedRarity)">@RarityLabel(replacedRarity)</div>
                <div class="skill-desc">@replacedDescription</div>
                <div class="skill-stats">
                    <strong>@replacedBaseDamage</strong> dano &middot;
                    @EffectIcon(replacedEffectType) @EffectLabel(replacedEffectType, replacedEffectValue)
                    &middot; <span style="color:@SkillClassColor(replacedClassName)">@SkillClassLabel(replacedClassName)</span>
                </div>
            </div>

            <div class="arrow-col" id="arrow-col">&rarr;</div>
        }

        <div class="skill-card acquired rarity-@acquiredRarity.ToLower()" id="acquired-card">
            <div class="skill-label" style="color:#66cc88;">Adquirida</div>
            <div class="skill-name">@acquiredName</div>
            <div class="skill-rarity" style="color:@RarityColor(acquiredRarity)">@RarityLabel(acquiredRarity)</div>
            <div class="skill-desc">@acquiredDescription</div>
            <div class="skill-stats">
                <strong>@acquiredBaseDamage</strong> dano &middot;
                @EffectIcon(acquiredEffectType) @EffectLabel(acquiredEffectType, acquiredEffectValue)
                &middot; <span style="color:@SkillClassColor(acquiredClassName)">@SkillClassLabel(acquiredClassName)</span>
            </div>
        </div>

    </div>

    <a href="/Battle/Start" class="btn-rpg">Continuar &rarr;</a>

</div>

<div id="loader" class="loader-overlay">
    <div class="loader-spinner"></div>
    <div class="loader-label">Carregando...</div>
</div>

<script>
(function () {
    var rarityAcquired = '@acquiredRarity';

    function animateIn() {
        var replaced = document.getElementById('replaced-card');
        var arrow    = document.getElementById('arrow-col');
        var acquired = document.getElementById('acquired-card');

        if (replaced) {
            setTimeout(function () { replaced.classList.add('visible'); }, 80);
        }
        if (arrow) {
            setTimeout(function () { arrow.classList.add('visible'); }, 300);
        }
        if (acquired) {
            setTimeout(function () {
                acquired.classList.add('visible');
                if (rarityAcquired === 'Epic' || rarityAcquired === 'Rare') {
                    spawnSparkles(acquired, rarityAcquired);
                }
            }, replaced ? 520 : 80);
        }
    }

    function spawnSparkles(el, rarity) {
        var color = rarity === 'Epic' ? '#ffd700' : '#56b4e9';
        var rect  = el.getBoundingClientRect();
        var cx    = rect.left + rect.width  / 2;
        var cy    = rect.top  + rect.height / 2;

        for (var i = 0; i < 18; i++) {
            (function (i) {
                setTimeout(function () {
                    var sp = document.createElement('div');
                    sp.className = 'sparkle';
                    var angle = (Math.random() * 360) * Math.PI / 180;
                    var dist  = 40 + Math.random() * 70;
                    var tx    = Math.cos(angle) * dist;
                    var ty    = Math.sin(angle) * dist;
                    sp.style.cssText = [
                        'width:6px', 'height:6px',
                        'background:' + color,
                        'border-radius:50%',
                        'left:' + (cx + window.scrollX) + 'px',
                        'top:' + (cy + window.scrollY) + 'px',
                        '--tx:' + tx + 'px',
                        '--ty:' + ty + 'px',
                        'box-shadow:0 0 4px ' + color
                    ].join(';');
                    document.body.appendChild(sp);
                    setTimeout(function () { sp.remove(); }, 1000);
                }, i * 40);
            })(i);
        }
    }

    window.addEventListener('load', animateIn);
})();
</script>
<script src="/js/loader.js"></script>
</body>
</html>
