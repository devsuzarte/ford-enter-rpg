@{
    ViewData["Title"] = "Criar Personagem";
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — FordEnterRPG</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/css/theme.css" />
    <style>
        body { display:flex; align-items:flex-start; justify-content:center; padding:2rem 1rem; }
        h1 { color:#c89838; font-size:1.6rem; font-family:var(--font-title); letter-spacing:.04em; text-shadow:0 0 18px rgba(201,162,39,.35); }

        .class-card {
            background:#15120e; border:2px solid #2e2820; border-radius:12px;
            padding:1.4rem 1rem; text-align:center; cursor:pointer;
            transition:border-color .15s, background .15s, transform .15s;
            height:100%;
        }
        .class-card:hover { border-color:#7a5818; background:#1e1a10; transform:translateY(-2px); }
        .class-card.selected { border-color:#d4a84b; background:#1c1408; }

        .class-portrait {
            width:90px; height:110px; object-fit:contain;
            display:block; margin:0 auto .7rem;
            transition: filter .2s;
        }
        .class-card:hover .class-portrait,
        .class-card.selected .class-portrait {
            filter: drop-shadow(0 0 10px currentColor);
        }
        .warrior-color { color:#d4804a; }
        .mage-color    { color:#4890c8; }
        .archer-color  { color:#60b870; }

        .class-card h5 { color:#ddd8c8; margin-bottom:.15rem; font-size:1rem; font-family:var(--font-label); letter-spacing:.06em; }
        .class-card .class-internal { color:#70654a; font-size:.68rem; margin-bottom:.6rem; font-family:var(--font-label); letter-spacing:.08em; text-transform:uppercase; }
        .class-card .stat   { font-size:.82rem; color:#9a9070; margin-bottom:.12rem; }
        .class-card .stat strong { color:#ddd8c8; }
        .class-card .adv    { font-size:.78rem; margin-top:.4rem; font-weight:600; }
        .class-card .desc   { font-size:.76rem; color:#70654a; margin-top:.45rem; }

        .btn-criar {
            background:#a07830; border-color:#c89838; color:#fff;
            font-size:1rem; padding:.65rem; border-radius:8px; width:100%;
            transition: background .15s, box-shadow .2s;
            font-family:var(--font-label); letter-spacing:.06em;
        }
        .btn-criar:hover { background:#c89838; border-color:#c89838; color:#fff; box-shadow:0 0 20px rgba(201,162,39,.35); }

        .error-msg {
            background:#2a0a0a; border:1px solid #6a2a2a;
            border-radius:8px; padding:.6rem .9rem;
            color:#ff9a9a; font-size:.88rem;
        }
    </style>
</head>
<body>
<div style="width:100%;max-width:740px;">

    <h1 class="mb-4">Criar Personagem</h1>

    @if (ViewBag.Error != null)
    {
        <div class="error-msg mb-3">@ViewBag.Error</div>
    }

    <form method="post" action="/Character/Create">

        <div class="mb-4">
            <label class="form-label" for="name">Nome do Personagem</label>
            <input id="name" type="text" name="Name" class="form-control"
                   placeholder="Ex: Arathorn, Lyra, Zephyr..." maxlength="50" required />
        </div>

        <div class="mb-4">
            <div class="form-label mb-2">Escolha sua Classe</div>
            <div class="row g-3">

                <div class="col-md-4">
                    <label class="w-100 h-100">
                        <input type="radio" name="Class" value="Warrior" class="d-none class-radio" required />
                        <div class="class-card warrior-color">
                            <img src="/images/warrior.svg" alt="Guerreiro" class="class-portrait" />
                            <h5>Guerreiro</h5>
                            <div class="class-internal">Warrior</div>
                            <div class="stat">Vida: <strong>25</strong></div>
                            <div class="stat">Bonus Dano: <strong>+7</strong></div>
                            <div class="adv" style="color:#d4804a;">Vantagem vs Mago</div>
                            <div class="desc">Tanque resistente com ataques fisicos devastadores.</div>
                        </div>
                    </label>
                </div>

                <div class="col-md-4">
                    <label class="w-100 h-100">
                        <input type="radio" name="Class" value="Mage" class="d-none class-radio" />
                        <div class="class-card mage-color">
                            <img src="/images/mage.svg" alt="Mago" class="class-portrait" />
                            <h5>Mago</h5>
                            <div class="class-internal">Mage</div>
                            <div class="stat">Vida: <strong>18</strong></div>
                            <div class="stat">Bonus Dano: <strong>+10</strong></div>
                            <div class="adv" style="color:#4890c8;">Vantagem vs Arqueiro</div>
                            <div class="desc">Magico de alto dano. Fragil, porem letal.</div>
                        </div>
                    </label>
                </div>

                <div class="col-md-4">
                    <label class="w-100 h-100">
                        <input type="radio" name="Class" value="Archer" class="d-none class-radio" />
                        <div class="class-card archer-color">
                            <img src="/images/archer.svg" alt="Arqueiro" class="class-portrait" />
                            <h5>Arqueiro</h5>
                            <div class="class-internal">Archer</div>
                            <div class="stat">Vida: <strong>20</strong></div>
                            <div class="stat">Bonus Dano: <strong>+8</strong></div>
                            <div class="adv" style="color:#60b870;">Vantagem vs Guerreiro</div>
                            <div class="desc">Equilibrado, rapido e preciso. Bom ponto de partida.</div>
                        </div>
                    </label>
                </div>

            </div>
        </div>

        <button type="submit" class="btn btn-criar">Entrar na Arena</button>

    </form>

</div>

<div id="loader" class="loader-overlay">
    <div class="loader-spinner"></div>
    <div class="loader-label">Criando personagem...</div>
</div>

<script>
    document.querySelectorAll('.class-radio').forEach(function(r) {
        r.addEventListener('change', function() {
            document.querySelectorAll('.class-card').forEach(function(c) { c.classList.remove('selected'); });
            if (r.checked) r.closest('label').querySelector('.class-card').classList.add('selected');
        });
    });
</script>
<script src="/js/transitions.js"></script>
</body>
</html>
