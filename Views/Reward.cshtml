@{
    ViewData["Title"] = "Recompensa";
    var battle    = ViewBag.Battle    as FordEnterRPG.Models.Battle;
    var character = ViewBag.Character as FordEnterRPG.Models.Character;
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — FordEnterRPG</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/css/theme.css" />
    <style>
        body { display:flex; justify-content:center; align-items:center; padding:2rem 1rem; }

        .page-title { color:#ffd700; font-size:1.6rem; font-weight:700; }
        .page-sub   { color:#9a9070; font-size:.92rem; }

        .reward-card {
            background:#15120e; border:2px solid #2e2820; border-radius:12px;
            padding:1.5rem 1rem; text-align:center; cursor:pointer;
            transition:border-color .2s, background .2s, transform .15s;
            height:100%;
        }
        .reward-card:hover { border-color:#a07830; background:#1e1a10; transform:translateY(-3px); }
        .reward-icon  { font-size:2.8rem; line-height:1; margin-bottom:.6rem; }
        .reward-title { font-size:1rem; font-weight:700; color:#ddd8c8; margin-bottom:.3rem; }
        .reward-desc  { font-size:.8rem; color:#70654a; margin-bottom:.6rem; }
        .reward-stat  { font-size:.9rem; font-weight:600; }

        .reward-btn { background:transparent; border:none; padding:0; width:100%; height:100%; display:block; }
        .reward-btn:focus .reward-card { border-color:#a07830; }

        .skill-reward-card {
            border-color: #3a2e10;
        }
        .skill-reward-card:hover {
            border-color:#c89838; background:#1c1808;
        }

        /* wheel legend */
        .wheel-legend { display:flex; flex-direction:column; gap:.5rem; align-items:flex-start; }
        .wl-item { display:flex; align-items:center; gap:.5rem; font-size:.85rem; }
        .wl-dot  { width:12px; height:12px; border-radius:50%; flex-shrink:0; }
    </style>
</head>
<body>
<div style="width:100%;max-width:720px;">

    <div class="text-center mb-5">
        <div class="page-title mb-1">Vitoria!</div>
        <div class="page-sub">
            Voce derrotou <strong style="color:#ddd8c8;">@battle?.EnemyName</strong>!<br />
            Agora e <strong style="color:#ddd8c8;">Nivel @character?.Level</strong>. Escolha sua recompensa:
        </div>
    </div>

    <div class="row g-3">

        <div class="col-md-4">
            <form method="post" action="/Battle/@battle?.Id/Reward" class="h-100">
                <input type="hidden" name="choice" value="Life" />
                <button type="submit" class="reward-btn h-100">
                    <div class="reward-card">
                        <div class="reward-icon">❤</div>
                        <div class="reward-title">+2 Vida Maxima</div>
                        <div class="reward-desc">Aumenta seu HP maximo de forma permanente.</div>
                        <div class="reward-stat" style="color:#ff8888;">
                            @character?.Life &rarr; @(character?.Life + 2)
                        </div>
                    </div>
                </button>
            </form>
        </div>

        <div class="col-md-4">
            <form method="post" action="/Battle/@battle?.Id/Reward" class="h-100">
                <input type="hidden" name="choice" value="Damage" />
                <button type="submit" class="reward-btn h-100">
                    <div class="reward-card">
                        <div class="reward-icon">⚔</div>
                        <div class="reward-title">+1 Bonus de Dano</div>
                        <div class="reward-desc">Aumenta o dano de todas as suas habilidades.</div>
                        <div class="reward-stat" style="color:#ffaa44;">
                            +@character?.Damage &rarr; +@(character?.Damage + 1)
                        </div>
                    </div>
                </button>
            </form>
        </div>

        <div class="col-md-4">
            <form method="post" action="/Battle/@battle?.Id/Reward" class="h-100" id="skill-reward-form" data-no-loader>
                <input type="hidden" name="choice" value="Skill" />
                <input type="hidden" name="rarity" value="" />
                <button type="submit" class="reward-btn h-100">
                    <div class="reward-card skill-reward-card">
                        <div class="reward-icon">✦</div>
                        <div class="reward-title">Habilidade Aleatoria</div>
                        <div class="reward-desc">
                            Recebe uma nova habilidade. Se tiver 4, a mais fraca sera substituida.
                        </div>
                        <div class="reward-stat" style="color:#c89838;">Girar a Roleta!</div>
                    </div>
                </button>
            </form>
        </div>

    </div>

    <!-- Rarity legend -->
    <div class="d-flex justify-content-center mt-4">
        <div class="wheel-legend">
            <div class="wl-item">
                <div class="wl-dot" style="background:#3a2a00;border:1px solid #ffd700;"></div>
                <span style="color:#ffd700;">Epico</span>
                <span style="color:#70654a;font-size:.78rem;">— maior chance (4x)</span>
            </div>
            <div class="wl-item">
                <div class="wl-dot" style="background:#0d3a5c;border:1px solid #56b4e9;"></div>
                <span style="color:#56b4e9;">Raro</span>
                <span style="color:#70654a;font-size:.78rem;">— chance media (2x)</span>
            </div>
            <div class="wl-item">
                <div class="wl-dot" style="background:#252520;border:1px solid #888877;"></div>
                <span style="color:#888877;">Comum</span>
                <span style="color:#70654a;font-size:.78rem;">— chance base (1x)</span>
            </div>
        </div>
    </div>

</div>

<!-- Roulette wheel overlay -->
<div id="wheel-overlay" class="wheel-overlay">
    <div class="wheel-title">Girando a Roleta de Raridade</div>
    <div class="wheel-wrap">
        <div class="wheel-pointer"></div>
        <canvas id="wheel-canvas" class="wheel-canvas" width="260" height="260"></canvas>
    </div>
    <div id="wheel-result" class="wheel-result" style="font-size:1.5rem;font-weight:700;opacity:0;transition:opacity .4s;min-height:2rem;"></div>
</div>

<!-- Generic loader -->
<div id="loader" class="loader-overlay">
    <div class="loader-spinner"></div>
    <div class="loader-label">Carregando...</div>
</div>

<script src="/js/roulette.js"></script>
<script src="/js/loader.js"></script>
</body>
</html>
