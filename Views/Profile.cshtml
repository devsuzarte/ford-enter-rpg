@model FordEnterRPG.DTOs.UserProfileDto
@{
    ViewData["Title"] = "Perfil";
    bool hasCharacter = ViewBag.HasCharacter as bool? ?? false;
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — FordEnterRPG</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <style>
        body { background: #0d0d1a; color: #dcdcf0; font-family: 'Segoe UI', sans-serif;
               min-height: 100vh; display: flex; align-items: center; justify-content: center; }
        .card {
            background: #14142a; border: 1px solid #2c2c4a;
            border-radius: 12px; width: 100%; max-width: 400px; padding: 2rem;
        }
        .card-title { color: #c0a0ff; font-size: 1.4rem; font-weight: 700; margin-bottom: 1.2rem; }
        .info-row { font-size: .88rem; color: #9090b8; margin-bottom: .4rem; }
        .info-row strong { color: #dcdcf0; }
        .divider { border-color: #2c2c4a; margin: 1.2rem 0; }

        .btn-jogar {
            background: #8b0000; border-color: #8b0000; color: #fff;
            font-size: 1rem; font-weight: 600; padding: .7rem; border-radius: 8px; width: 100%;
        }
        .btn-jogar:hover { background: #aa0000; border-color: #aa0000; color: #fff; }
        .btn-outline-rpg {
            background: transparent; border: 1px solid #3a3a5a; color: #9090b8;
            font-size: .88rem; padding: .5rem; border-radius: 8px; width: 100%;
            text-align: center; text-decoration: none; display: block;
        }
        .btn-outline-rpg:hover { border-color: #7c5cbf; color: #c0a0ff; }
        .role-badge {
            display: inline-block; background: #1e1640; border: 1px solid #5c3c9f;
            border-radius: 12px; padding: .15rem .6rem; font-size: .75rem; color: #c0a0ff;
        }
    </style>
</head>
<body>
<div class="card shadow-lg">

    <div class="card-title">Perfil</div>

    <div class="info-row"><strong>@Model.Name</strong></div>
    <div class="info-row">@Model.Email</div>
    <div class="info-row mt-1"><span class="role-badge">@(Model.Role ?? "User")</span></div>

    <hr class="divider" />

    <div class="d-flex flex-column gap-2">
        @if (hasCharacter)
        {
            <a href="/Battle/Start" class="btn btn-jogar text-decoration-none text-center">Jogar</a>
            <a href="/Character" class="btn-outline-rpg">Ver Personagem</a>
        }
        else
        {
            <a href="/Character/Create" class="btn btn-jogar text-decoration-none text-center">Criar Personagem</a>
        }
        <form method="post" action="/SignOut">
            <button type="submit" class="btn-outline-rpg" style="border:none;cursor:pointer;">Sair</button>
        </form>
    </div>

</div>
<div id="loader" style="display:none;position:fixed;inset:0;background:rgba(5,5,20,.8);z-index:9999;flex-direction:column;align-items:center;justify-content:center;">
    <div style="width:42px;height:42px;border:4px solid #2c2c4a;border-top-color:#7c5cbf;border-radius:50%;animation:_sp .65s linear infinite;"></div>
    <div style="color:#9090b8;margin-top:12px;font-size:.82rem;">Carregando...</div>
</div>
<style>@@keyframes _sp{to{transform:rotate(360deg)}}</style>
<script>
(function(){var o=document.getElementById('loader');function s(){o.style.display='flex';}
document.addEventListener('submit',s);
document.addEventListener('click',function(e){var a=e.target.closest('a[href]');if(!a)return;var h=a.getAttribute('href')||'';if(!h||h[0]==='#'||/^(https?:|mailto:)/.test(h))return;s();});})();
</script>
</body>
</html>
