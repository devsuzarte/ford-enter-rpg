@model FordEnterRPG.DTOs.UserProfileDto
@{
    ViewData["Title"] = "Perfil";
    bool hasCharacter = ViewBag.HasCharacter as bool? ?? false;
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — FordEnterRPG</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@400;700;900&family=Cinzel:wght@400;600;700&family=EB+Garamond:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <style>
        body {
            background-color: #0d0b09;
            background-image: radial-gradient(ellipse at center, transparent 45%, rgba(0,0,0,0.55) 100%);
            background-attachment: fixed;
            color: #ddd8c8; font-family: 'EB Garamond', 'Segoe UI', serif;
            min-height: 100vh; display: flex; align-items: center; justify-content: center;
        }
        body::after {
            content: '';
            position: fixed; inset: 0;
            background: repeating-linear-gradient(0deg,transparent,transparent 3px,rgba(0,0,0,.03) 3px,rgba(0,0,0,.03) 4px);
            pointer-events: none; z-index: 9000;
        }
        .card {
            background: #15120e; border: 1px solid #2e2820;
            border-radius: 12px; width: 100%; max-width: 400px; padding: 2rem;
            position: relative; overflow: hidden;
        }
        .card::before {
            content:''; position:absolute; inset:0; border-radius:12px;
            background:radial-gradient(ellipse at 50% 0%, rgba(160,120,48,.07) 0%, transparent 65%);
            pointer-events:none;
        }
        .card-title {
            color: #c89838; font-size: 1.4rem; font-weight: 700; margin-bottom: 1.2rem;
            font-family: 'Cinzel Decorative', 'Cinzel', serif;
            letter-spacing: .04em; text-shadow: 0 0 16px rgba(201,162,39,.35);
        }
        .info-row { font-size: .88rem; color: #9a9070; margin-bottom: .4rem; }
        .info-row strong { color: #ddd8c8; }
        .divider { border-color: #2e2820; margin: 1.2rem 0; }

        .btn-jogar {
            background: #a07830; border-color: #c89838; color: #fff;
            font-size: 1rem; font-weight: 600; padding: .7rem; border-radius: 8px; width: 100%;
            font-family: 'Cinzel', serif; letter-spacing: .06em;
            transition: background .15s, box-shadow .2s;
        }
        .btn-jogar:hover { background: #c89838; border-color: #c89838; color: #fff; box-shadow: 0 0 20px rgba(201,162,39,.35); }
        .btn-outline-rpg {
            background: transparent; border: 1px solid #3c3426; color: #9a9070;
            font-size: .85rem; padding: .5rem; border-radius: 8px; width: 100%;
            text-align: center; text-decoration: none; display: block;
            font-family: 'Cinzel', serif; letter-spacing: .05em;
            transition: border-color .15s, color .15s;
        }
        .btn-outline-rpg:hover { border-color: #a07830; color: #d4a84b; }
        .role-badge {
            display: inline-block; background: #1c1408; border: 1px solid #7a5818;
            border-radius: 12px; padding: .15rem .6rem; font-size: .75rem; color: #d4a84b;
            font-family: 'Cinzel', serif; letter-spacing: .05em;
        }
        .btn-sair {
            background: transparent; border: 1px solid #3c3426; color: #9a9070;
            font-size: .85rem; padding: .5rem; border-radius: 8px; width: 100%;
            text-align: center; cursor: pointer;
            font-family: 'Cinzel', serif; letter-spacing: .05em;
            transition: border-color .15s, color .15s;
        }
        .btn-sair:hover { border-color: #6a2a2a; color: #ff9a9a; }
    </style>
</head>
<body>
<div class="card shadow-lg">

    <div class="card-title">Perfil</div>

    <div class="info-row"><strong>@Model.Name</strong></div>
    <div class="info-row">@Model.Email</div>
    <div class="info-row mt-1"><span class="role-badge">@(Model.Role ?? "User")</span></div>

    <hr class="divider" />

    <div class="d-flex flex-column gap-2">
        @if (hasCharacter)
        {
            <a href="/Battle/Start" class="btn btn-jogar text-decoration-none text-center">Jogar</a>
            <a href="/Character" class="btn-outline-rpg">Ver Personagem</a>
        }
        else
        {
            <a href="/Character/Create" class="btn btn-jogar text-decoration-none text-center">Criar Personagem</a>
        }
        <form method="post" action="/SignOut">
            <button type="submit" class="btn-sair">Sair</button>
        </form>
    </div>

</div>
<style>
    .loader-overlay{display:none;position:fixed;inset:0;background:rgba(5,4,2,.88);z-index:9999;flex-direction:column;align-items:center;justify-content:center;}
    .loader-spinner{width:42px;height:42px;border:4px solid #2e2820;border-top-color:#a07830;border-radius:50%;animation:_sp .65s linear infinite;}
    .loader-label{color:#9a9070;margin-top:12px;font-size:.82rem;font-family:'Cinzel',serif;letter-spacing:.08em;}
    @@keyframes _sp{to{transform:rotate(360deg)}}
</style>
<div id="loader" class="loader-overlay">
    <div class="loader-spinner"></div>
    <div class="loader-label">Carregando...</div>
</div>
<script>
(function(){var o=document.getElementById('loader');function s(){o.style.display='flex';}
document.addEventListener('submit',s);
document.addEventListener('click',function(e){var a=e.target.closest('a[href]');if(!a)return;var h=a.getAttribute('href')||'';if(!h||h[0]==='#'||/^(https?:|mailto:)/.test(h))return;s();});})();
</script>
<script src="/js/transitions.js"></script>
</body>
</html>
