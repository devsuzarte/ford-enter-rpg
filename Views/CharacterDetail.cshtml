@model FordEnterRPG.Models.Character
@{
    ViewData["Title"] = "Personagem";
    var activeBattle = ViewBag.ActiveBattle as FordEnterRPG.Models.Battle;

    string ClassLabel(string c) => c switch
        { "Warrior" => "Guerreiro", "Mage" => "Mago", "Archer" => "Arqueiro", _ => c };
    string ClassIcon(string c) => c switch
        { "Warrior" => "🗡", "Mage" => "🔮", "Archer" => "🏹", _ => "⚔" };
    string RarityLabel(string r) => r switch
        { "Epic" => "Epico", "Rare" => "Raro", _ => "Comum" };
    string RarityColor(string r) => r switch
        { "Epic" => "#ffd700", "Rare" => "#56b4e9", _ => "#888899" };
    string EffectLabel(string e, int v) => e switch
    {
        "Crit" => "50% Critico",
        "Stun" => "30% Atordoar",
        "Heal" => $"+{v} HP",
        _      => "Sem efeito"
    };
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@Model.Name — FordEnterRPG</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <style>
        body { background: #0d0d1a; color: #dcdcf0; font-family: 'Segoe UI', sans-serif;
               min-height: 100vh; display: flex; justify-content: center;
               align-items: flex-start; padding: 1.5rem 1rem; }

        h1 { color: #c0a0ff; font-size: 1.5rem; margin: 0; }
        h2 { color: #a090d0; font-size: 1.1rem; margin-bottom: .8rem; text-transform: uppercase;
             letter-spacing: .06em; font-weight: 600; }

        .panel { background: #14142a; border: 1px solid #2c2c4a; border-radius: 10px; padding: 1rem 1.2rem; }

        /* Stats */
        .stat-box {
            background: #0d0d1e;
            border: 1px solid #2a2a42;
            border-radius: 8px;
            padding: .8rem .5rem;
            text-align: center;
        }
        .stat-value { font-size: 1.6rem; font-weight: 700; line-height: 1; }
        .stat-label { font-size: 0.72rem; color: #6060a0; margin-top: .25rem; }

        /* Badge de classe */
        .class-badge {
            display: inline-block;
            background: #1e1640;
            border: 1px solid #5c3c9f;
            border-radius: 20px;
            padding: .25rem .8rem;
            font-size: .85rem;
            color: #c0a0ff;
            font-weight: 600;
        }

        /* Cards de habilidade */
        .skill-card {
            background: #0d0d1e;
            border: 1px solid #2a2a42;
            border-radius: 8px;
            padding: .8rem 1rem;
        }
        .skill-name  { font-size: .93rem; font-weight: 600; color: #dcdcf0; }
        .skill-rarity{ font-size: .75rem; }
        .skill-desc  { font-size: .78rem; color: #7070a0; margin-top: .15rem; }
        .skill-stats { font-size: .78rem; color: #9090b8; margin-top: .4rem; }
        .skill-stats strong { color: #e0e0e0; }

        /* Botoes */
        .btn-play {
            background: #8b0000; border-color: #8b0000;
            color: #fff; font-size: 1rem; font-weight: 600;
            padding: .7rem 1.2rem; border-radius: 8px; width: 100%;
        }
        .btn-play:hover { background: #aa0000; border-color: #aa0000; color: #fff; }
        .btn-continue {
            background: #7c5c00; border-color: #7c5c00;
            color: #fff; font-size: 1rem; font-weight: 600;
            padding: .7rem 1.2rem; border-radius: 8px; width: 100%;
        }
        .btn-continue:hover { background: #9c7c00; border-color: #9c7c00; color: #fff; }
        .btn-back {
            font-size: .82rem; color: #7070a0; text-decoration: none;
            border: 1px solid #2a2a42; border-radius: 6px; padding: .3rem .7rem;
        }
        .btn-back:hover { color: #c0a0ff; border-color: #5c3c9f; }

        /* Record */
        .record-win  { color: #66dd88; font-weight: 700; font-size: 1.4rem; }
        .record-lose { color: #dd6666; font-weight: 700; font-size: 1.4rem; }
    </style>
</head>
<body>
<div style="width:100%;max-width:680px;">

    <!-- Cabecalho -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>@ClassIcon(Model.Class) @Model.Name</h1>
            <div class="mt-1">
                <span class="class-badge">@ClassLabel(Model.Class)</span>
                <span style="font-size:.82rem; color:#6060a0; margin-left:.5rem;">Nivel @Model.Level</span>
            </div>
        </div>
        <a href="/Profile" class="btn-back">Perfil</a>
    </div>

    <!-- Stats -->
    <div class="row g-2 mb-4">
        <div class="col-4 col-sm">
            <div class="stat-box">
                <div class="stat-value" style="color:#c0a0ff;">@Model.Level</div>
                <div class="stat-label">Nivel</div>
            </div>
        </div>
        <div class="col-4 col-sm">
            <div class="stat-box">
                <div class="stat-value" style="color:#ff6666;">@Model.Life</div>
                <div class="stat-label">Vida Max.</div>
            </div>
        </div>
        <div class="col-4 col-sm">
            <div class="stat-box">
                <div class="stat-value" style="color:#ffaa44;">+@Model.Damage</div>
                <div class="stat-label">Bonus Dano</div>
            </div>
        </div>
        <div class="col-6 col-sm">
            <div class="stat-box">
                <div class="stat-value record-win">@Model.Wins</div>
                <div class="stat-label">Vitorias</div>
            </div>
        </div>
        <div class="col-6 col-sm">
            <div class="stat-box">
                <div class="stat-value record-lose">@Model.Losses</div>
                <div class="stat-label">Derrotas</div>
            </div>
        </div>
    </div>

    <!-- Habilidades -->
    <div class="mb-4">
        <h2>Habilidades</h2>
        @if (!Model.CharacterSkills.Any())
        {
            <div style="color:#505070; font-size:.88rem;">Nenhuma habilidade ainda.</div>
        }
        else
        {
            <div class="row g-2">
                @foreach (var cs in Model.CharacterSkills.OrderBy(x => x.Slot))
                {
                    var s = cs.Skill;
                    <div class="col-12 col-sm-6">
                        <div class="skill-card">
                            <div class="d-flex justify-content-between align-items-baseline">
                                <span class="skill-name">@s.Name</span>
                                <span class="skill-rarity" style="color:@RarityColor(s.Rarity)">@RarityLabel(s.Rarity)</span>
                            </div>
                            <div class="skill-desc">@s.Description</div>
                            <div class="skill-stats">
                                <strong>@s.BaseDamage</strong> dano base &nbsp;&middot;&nbsp; @EffectLabel(s.EffectType, s.EffectValue)
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Acao -->
    @if (activeBattle != null)
    {
        <a href="/Battle/@activeBattle.Id" class="btn btn-continue text-decoration-none d-block text-center">
            Continuar Batalha
        </a>
    }
    else
    {
        <a href="/Battle/Start" class="btn btn-play text-decoration-none d-block text-center">
            Nova Batalha
        </a>
    }

</div>
<div id="loader" style="display:none;position:fixed;inset:0;background:rgba(5,5,20,.8);z-index:9999;flex-direction:column;align-items:center;justify-content:center;">
    <div style="width:42px;height:42px;border:4px solid #2c2c4a;border-top-color:#7c5cbf;border-radius:50%;animation:_sp .65s linear infinite;"></div>
    <div style="color:#9090b8;margin-top:12px;font-size:.82rem;">Carregando...</div>
</div>
<style>@@keyframes _sp{to{transform:rotate(360deg)}}</style>
<script>
(function(){var o=document.getElementById('loader');function s(){o.style.display='flex';}
document.addEventListener('submit',s);
document.addEventListener('click',function(e){var a=e.target.closest('a[href]');if(!a)return;var h=a.getAttribute('href')||'';if(!h||h[0]==='#'||/^(https?:|mailto:)/.test(h))return;s();});})();
</script>
</body>
</html>
