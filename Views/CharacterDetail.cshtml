@model FordEnterRPG.Models.Character
@{
    ViewData["Title"] = "Personagem";
    var activeBattle = ViewBag.ActiveBattle as FordEnterRPG.Models.Battle;

    string ClassLabel(string c) => c switch
        { "Warrior" => "Guerreiro", "Mage" => "Mago", "Archer" => "Arqueiro", _ => c };
    string ClassIcon(string c) => c switch
        { "Warrior" => "🗡", "Mage" => "🔮", "Archer" => "🏹", _ => "⚔" };
    string RarityLabel(string r) => r switch
        { "Epic" => "Epico", "Rare" => "Raro", _ => "Comum" };
    string RarityColor(string r) => r switch
        { "Epic" => "#ffd700", "Rare" => "#56b4e9", _ => "#888877" };
    string SkillClassLabel(string c) => c switch
        { "Warrior" => "Guerreiro", "Mage" => "Mago", "Archer" => "Arqueiro", _ => "Universal" };
    string SkillClassColor(string c) => c switch
        { "Warrior" => "#d4804a", "Mage" => "#4890c8", "Archer" => "#60b870", _ => "#8a8468" };
    string EffectLabel(string e, int v) => e switch
    {
        "Crit" => "50% Critico",
        "Stun" => "30% Atordoar",
        "Heal" => $"+{v} HP",
        _      => "Sem efeito"
    };
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@Model.Name — FordEnterRPG</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/css/theme.css" />
    <style>
        body { display: flex; justify-content: center;
               align-items: flex-start; padding: 1.5rem 1rem; }

        h1 { color: #c89838; font-size: 1.5rem; margin: 0; font-family: var(--font-title); letter-spacing: .04em; text-shadow: 0 0 16px rgba(201,162,39,.35); }
        h2 { color: #c89838; font-size: .95rem; margin-bottom: .8rem; text-transform: uppercase;
             letter-spacing: .1em; font-weight: 700; font-family: var(--font-label); }

        .skill-card {
            background: #0d0b09;
            border: 1px solid #2a2010;
            border-radius: 8px;
            padding: .8rem 1rem;
            transition: border-color .2s;
        }
        .skill-card:hover { border-color: var(--accent-lo); }
        .skill-name  { font-size: .93rem; font-weight: 700; color: #ddd8c8; font-family: var(--font-label); letter-spacing: .03em; }
        .skill-rarity{ font-size: .72rem; font-family: var(--font-label); }
        .skill-desc  { font-size: .80rem; color: #70654a; margin-top: .15rem; }
        .skill-stats { font-size: .78rem; color: #9a9070; margin-top: .4rem; }
        .skill-stats strong { color: #ddd8c8; }

        .btn-play {
            background: #004c8b; border-color: #004c8b;
            color: #fff; font-size: 1rem; font-weight: 600;
            padding: .7rem 1.2rem; border-radius: 8px; width: 100%;
            font-family: var(--font-label); letter-spacing: .06em;
            transition: background .15s, box-shadow .2s;
        }
        .btn-play:hover { background: #aa0000; border-color: #cc2020; color: #fff; box-shadow: 0 0 18px rgba(180,0,0,.4); }
        .btn-continue {
            background: #a07830; border-color: #c89838;
            color: #fff; font-size: 1rem; font-weight: 600;
            padding: .7rem 1.2rem; border-radius: 8px; width: 100%;
            font-family: var(--font-label); letter-spacing: .06em;
            transition: background .15s, box-shadow .2s;
        }
        .btn-continue:hover { background: #c89838; border-color: #c89838; color: #fff; box-shadow: 0 0 18px rgba(201,162,39,.35); }
        .btn-back {
            font-size: .82rem; color: #9a9070; text-decoration: none;
            border: 1px solid #2e2820; border-radius: 6px; padding: .3rem .7rem;
            font-family: var(--font-label); letter-spacing: .04em;
        }
        .btn-back:hover { color: #d4a84b; border-color: #7a5818; }

        .record-win  { color: #66dd88; font-weight: 700; font-size: 1.4rem; }
        .record-lose { color: #dd6666; font-weight: 700; font-size: 1.4rem; }

        .dead-banner {
            background: #1a0808;
            border: 1px solid #7a1a1a;
            border-radius: 10px;
            padding: 1.2rem 1.4rem;
            text-align: center;
        }
        .dead-banner .dead-title { color: #dd4444; font-size: 1.2rem; font-weight: 700; margin-bottom: .4rem; }
        .dead-banner .dead-sub   { color: #806060; font-size: .86rem; }
    </style>
</head>
<body>
<div style="width:100%;max-width:680px;margin:0 auto;">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>@ClassIcon(Model.Class) @Model.Name</h1>
            <div class="mt-1">
                <span class="class-badge">@ClassLabel(Model.Class)</span>
                <span style="font-size:.82rem; color:#70654a; margin-left:.5rem;">Nivel @Model.Level</span>
            </div>
        </div>
        <a href="/Profile" class="btn-back">Perfil</a>
    </div>

    <div class="row g-2 mb-4">
        <div class="col-4 col-sm">
            <div class="stat-box">
                <div class="stat-value" style="color:#d4a84b;">@Model.Level</div>
                <div class="stat-label">Nivel</div>
            </div>
        </div>
        <div class="col-4 col-sm">
            <div class="stat-box">
                <div class="stat-value" style="color:#ff6666;">@Model.Life</div>
                <div class="stat-label">Vida Max.</div>
            </div>
        </div>
        <div class="col-4 col-sm">
            <div class="stat-box">
                <div class="stat-value" style="color:#ffaa44;">+@Model.Damage</div>
                <div class="stat-label">Bonus Dano</div>
            </div>
        </div>
        <div class="col-6 col-sm">
            <div class="stat-box">
                <div class="stat-value record-win">@Model.Wins</div>
                <div class="stat-label">Vitorias</div>
            </div>
        </div>
        <div class="col-6 col-sm">
            <div class="stat-box">
                <div class="stat-value record-lose">@Model.Losses</div>
                <div class="stat-label">Derrotas</div>
            </div>
        </div>
    </div>

    <div class="mb-4">
        <h2>Habilidades</h2>
        @if (!Model.CharacterSkills.Any())
        {
            <div style="color:#70654a; font-size:.88rem;">Nenhuma habilidade ainda.</div>
        }
        else
        {
            <div class="row g-2">
                @foreach (var cs in Model.CharacterSkills.OrderBy(x => x.Slot))
                {
                    var s = cs.Skill;
                    <div class="col-12 col-sm-6">
                        <div class="skill-card">
                            <div class="d-flex justify-content-between align-items-baseline">
                                <span class="skill-name">@s.Name</span>
                                <span class="skill-rarity" style="color:@RarityColor(s.Rarity)">@RarityLabel(s.Rarity)</span>
                            </div>
                            <div class="skill-desc">@s.Description</div>
                            <div class="skill-stats">
                                <strong>@s.BaseDamage</strong> dano base &nbsp;&middot;&nbsp; @EffectLabel(s.EffectType, s.EffectValue)
                                &nbsp;&middot;&nbsp;
                                <span style="color:@SkillClassColor(s.ClassName)">@SkillClassLabel(s.ClassName)</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    @if (Model.IsDead)
    {
        <div class="dead-banner">
            <div class="dead-title">&#x2620; Personagem Morto</div>
            <div class="dead-sub">Este personagem foi derrotado em batalha e nao pode mais lutar.</div>
            <form method="post" action="/Character/Reset" class="mt-3">
                <button type="submit" class="btn btn-sm btn-danger">
                    Recomecar com novo personagem
                </button>
            </form>
        </div>
    }
    else if (activeBattle != null)
    {
        <a href="/Battle/@activeBattle.Id" class="btn btn-continue text-decoration-none d-block text-center">
            Continuar Batalha
        </a>
    }
    else
    {
        <a href="/Battle/Start" class="btn btn-play text-decoration-none d-block text-center">
            Nova Batalha
        </a>
    }

</div>
<div id="loader" class="loader-overlay">
    <div class="loader-spinner"></div>
    <div class="loader-label">Carregando...</div>
</div>
<script src="/js/transitions.js"></script>
</body>
</html>
